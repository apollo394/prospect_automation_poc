UVICORN_PORT=8002

OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=anthropic/claude-sonnet-4
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://simplicreative.com
OPENROUTER_APP_NAME=Prospect Intelligence

# openrouter | mock — omit to auto-select (OpenRouter when key is set)
AI_PROVIDER=openrouter

# Supabase Auth + optional primary store
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Set to 1 only after migrations + seed; otherwise JSON fixtures remain the store.
USE_SUPABASE_STORE=0
# Force open API without JWT (tests / local without Supabase). Auto-on when SUPABASE_URL empty.
# AUTH_BYPASS=1
