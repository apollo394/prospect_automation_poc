#!/usr/bin/env bash
# Start API on project default port 8002 (from .env UVICORN_PORT).
set -euo pipefail
cd "$(dirname "$0")"
ROOT="$(cd .. && pwd)"
# Single project venv lives at repo root.
if [[ -x "$ROOT/.venv/bin/python" ]]; then
  PY="$ROOT/.venv/bin/python"
else
  echo "No virtualenv found. Create one at repo root:" >&2
  echo "  cd $ROOT && python3 -m venv .venv && .venv/bin/pip install -r backend/requirements.txt" >&2
  exit 1
fi
if ! "$PY" -c "import jwt" 2>/dev/null; then
  echo "PyJWT missing in $PY — run: $PY -m pip install -r requirements.txt" >&2
  exit 1
fi
echo "Using Python: $PY" >&2
# dotenv loads backend/.env (incl. UVICORN_PORT=8002); Click maps UVICORN_PORT → --port.
# Fallback --port if .env is missing. Extra "$@" can still override.
has_port=0
for arg in "$@"; do
  [[ "$arg" == --port || "$arg" == --port=* ]] && has_port=1 && break
done
if [[ $has_port -eq 0 ]]; then
  set -- --port "${UVICORN_PORT:-8002}" "$@"
fi
exec "$PY" -m dotenv run -- "$PY" -m uvicorn main:app --reload --host 127.0.0.1 "$@"
